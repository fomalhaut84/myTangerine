{
  "name": "mytangerine-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "myTangerine - TypeScript 기반 감귤 주문 관리 시스템",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy"
  },
  "keywords": [
    "order-management",
    "google-sheets",
    "typescript",
    "monorepo"
  ],
  "author": "fomalhaut84",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "esbuild": ">=0.25.0",
      "qs": ">=6.14.1",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "uuid@<11.1.1": "^11.1.1",
      "deepmerge-ts@<8.0.0": "^8.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
