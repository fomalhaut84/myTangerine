# 웹 서버 포트 (기본값: 3000)
# Next.js 개발 서버가 사용할 포트 번호
PORT=3000

# API 서버 내부 URL (#220) — 브라우저는 API 를 직접 부르지 않고 웹 서버(/bff)를 거친다.
# 웹 서버가 이 주소로 전달한다. 기본값 http://127.0.0.1:3001 (NEXT_PUBLIC_API_BASE_URL 은 더 쓰지 않는다)
# API_INTERNAL_URL=http://127.0.0.1:3001

# 관리자 로그인 (#219) — 둘 다 없으면 로그인할 수 없다(fail-closed)
# 세션 서명 키(32자 이상) · 바꾸면 모든 세션이 로그아웃된다(비밀번호를 바꿔도 같다). 생성: openssl rand -hex 32
SESSION_SECRET=
# 관리자 비밀번호 해시 · 생성: pnpm --filter @mytangerine/web hash-password (출력 줄을 그대로 붙여 넣는다)
ADMIN_PASSWORD_HASH=
# HTTPS 가 아닌 운영 환경일 때만 false (기본: 운영 true)
# SESSION_COOKIE_SECURE=false
# IP 와 무관한 로그인 실패 전역 상한(10분) — 기본 0(꺼짐). 켜면 누구나 관리자를 잠글 수 있다.
# WEB_HOST=127.0.0.1 + 리버스 프록시 X-Forwarded-For 가 갖춰지지 않은 배치에서만 켠다
# LOGIN_GLOBAL_MAX_FAILURES=0
# 웹 서버 바인딩 주소 — 리버스 프록시 뒤라면 127.0.0.1 (로그인 시도 제한이 프록시가 붙인 X-Forwarded-For 를 믿는다)
# WEB_HOST=127.0.0.1

# API 인증 키 (서버 전용) — 루트 .env 의 API_SECRET_KEY 와 같은 값.
# 웹 서버(/bff)가 API 로 전달할 때만 붙인다 — 브라우저에 가지 않는다
API_SECRET_KEY=

# 환경 구분
NEXT_PUBLIC_APP_ENV=local

# 라벨 프린트 설정
LABEL_PRINT_PAGE_SIZE=A6

# 설정 방법:
# 1. 이 파일(.env.example)을 복사하여 .env.local 파일을 생성하세요
#    cp .env.example .env.local
# 2. .env.local 파일에서 필요한 값들을 수정하세요
# 3. .env.local 파일은 git에 커밋되지 않습니다 (.gitignore에 포함)
#
# 포트 변경 방법:
# - .env.local에서 PORT 값을 수정하세요
# - dev/start 스크립트가 자동으로 PORT 환경 변수를 읽어서 적용합니다
# - 또는 실행 시: PORT=4000 pnpm dev
