{
  "name": "@mytangerine/api",
  "version": "0.1.0",
  "description": "myTangerine API 서버 (Fastify)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "fastify",
    "rest-api",
    "order-management"
  ],
  "author": "fomalhaut84",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@mytangerine/core": "workspace:*",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pdfmake": "^0.2.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.2.13",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
